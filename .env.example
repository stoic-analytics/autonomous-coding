# Authentication: subscription | api | auto (default)
#   subscription - use the Claude CLI login ('claude login'); ANTHROPIC_API_KEY is ignored
#   api          - use ANTHROPIC_API_KEY (API billing)
#   auto         - an ANTHROPIC_API_KEY, if set, takes precedence
# AUTH_MODE=subscription
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: N8N webhook for progress notifications
# PROGRESS_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/...
